<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Package.props" />
	
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OneOf" />
    <PackageReference Include="Silk.NET.OpenGLES" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aura3D.Tests" />
  </ItemGroup>

  <ItemGroup>
	<Compile Update="ShaderResource.Designer.cs">
		<DesignTime>True</DesignTime>
		<AutoGen>True</AutoGen>
		<DependentUpon>ShaderResource.resx</DependentUpon>
	</Compile>
    <EmbeddedResource Update="ShaderResource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ShaderResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
