<Project Sdk="Microsoft.NET.Sdk">

  <!--
    纯打包工程：没有一行 C# 代码，唯一职责是把 ANGLE 为 macOS 构建出的 libEGL.dylib /
    libGLESv2.dylib 连同 IOSurface 创建的 C shim（libAura3dAngleMacOSHelper.dylib）和一段
    拷贝注入的 targets 发成 NuGet 包，让 macOS 桌面应用不必自己去找 ANGLE 产物。

    切片直接提交在 native/macos-arm64/ 下（由同目录的 build-angle-macos.sh 产出后更新，
    CI 的 build-macos-lib.yml 也会在 macos runner 上重建后再打包），所以打包不依赖本机
    是否检出 ANGLE。

    与 iOS 包的两点结构性差异：
    1. dylib 是动态库，运行时由 MacAngleNative 从应用目录 dlopen——不是静态链入主程序，
       因此 targets 注入的是「拷贝到输出目录」而非 NativeReference；
    2. 消费方是 net8.0/net10.0 桌面工程（不带 -macos 后缀），NativeReference 只被
       Apple 工作负载的 targets 处理，net10.0 根本不看它——拷贝注入是唯一通路。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependencies>true</SuppressDependencies>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>Aura3D.Angle.MacOS</PackageId>
    <!-- 版本号就写死在这行：不引用 Directory.Packages.props 里的属性，也不走 MinVer（版本不来自 git tag）。
         发布时 build-macos-lib.yml 用 -p:Version 覆盖它，全局属性优先于本文件的赋值。
         它要和 Directory.Packages.props 里主包钉的精确区间成对改：两处不一致时 CI 判错退出。 -->
    <Version>0.1.0</Version>
    <Authors>CeSun</Authors>
    <RepositoryUrl>https://github.com/CeSun/Aura3d</RepositoryUrl>
    <PackageTags>angle;macos;opengles;metal;avalonia;aura3d</PackageTags>
    <Description>ANGLE (Metal backend) macOS dylibs plus the IOSurface helper for the Aura3D.Avalonia render path.</Description>
    <!-- 包体只有 ANGLE 的二进制，许可证按 ANGLE 自己的 BSD-3-Clause 走，原文随包分发 -->
    <PackageLicenseFile>LICENSE.angle.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>ANGLE 58f8882372e8a4e83da821ac5d16f0323c3fa1af, gn: angle_enable_metal=true, is_debug=false, enable_rust=false, target_os=mac, target_cpu=arm64。
已验证：Gallery 桌面端经 ANGLE 桥完整出图（点云与模型混载页），点尺寸生效。</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="native/**" Pack="true" PackagePath="native/" />
    <!-- 同一份 targets 打进 build/ 与 buildTransitive/ 两个约定目录，文件里用哨兵防重复注入 -->
    <None Include="build/Aura3D.Angle.MacOS.targets" Pack="true" PackagePath="build/" />
    <None Include="build/Aura3D.Angle.MacOS.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE.angle.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- 忘了先构建 ANGLE/shim 就打包时，给出可执行的提示，而不是发一个空壳包出去 -->
  <Target Name="AngleNativeCheck" BeforeTargets="Pack">
    <Error Condition=" !Exists('$(MSBuildProjectDirectory)/native/macos-arm64/libEGL.dylib') "
           Text="No ANGLE slice under native/macos-arm64/. Run build-angle-macos.sh first, or manually place built dylibs into native/macos-arm64/." />
  </Target>

</Project>
