<Project>
  <!--
    浏览器（WebGL2）后端对应用工程有两个硬性要求，两者都只能在**应用**的构建属性里成立：

    1. WasmBuildNative：Avalonia 的 WebGL 渲染目标与 Aura3D 的 GLES 入口点都从应用自己的
       wasm 模块里取 libSkiaSharp 符号。这是**必要条件而不是充分条件**——本机 SDK 没有
       wasm-tools/emsdk workload 时链接照样不发生，模块里没有那些符号，应用启动即
       System.DllNotFoundException: libSkiaSharp（实测见 Aura3D.Avalonia.Browser.targets 的注释）。
       该情况由同包的 targets 在构建期报 Error，不会让人对着一条无上下文的运行时异常猜。
    2. emscripten 的链接开关：FULL_ES3 把 GLES2/GLES3 实现链进模块（默认只有 WebGL1 通道），
       MIN/MAX_WEBGL_VERSION=2 保证创建的是 WebGL2 上下文——GLES3 的入口点（VAO、UBO、
       3D 纹理、blitFramebuffer）在 WebGL1 上下文上取不到，管线会整块不出图。

    库自己设置不了这些（它们作用于最终可执行的 wasm 链接），所以由本包在装包时注入。
    应用侧只需引用 Aura3D.Avalonia，和 iOS 上 Aura3D.Angle.iOS 注入 NativeReference 同构。
  -->
  <PropertyGroup Condition=" '$(Aura3DBrowserWasmPropsImported)' == 'true' Or !$(TargetFramework.Contains('-browser')) ">
    <Aura3DBrowserWasmPropsSkip>true</Aura3DBrowserWasmPropsSkip>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Aura3DBrowserWasmPropsSkip)' != 'true' ">
    <!-- 同一份文件会被 build/ 与 buildTransitive/ 两个约定目录命中，哨兵保证只生效一次 -->
    <Aura3DBrowserWasmPropsImported>true</Aura3DBrowserWasmPropsImported>
    <WasmBuildNative Condition=" '$(WasmBuildNative)' == '' ">true</WasmBuildNative>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -s FULL_ES3=1 -s MAX_WEBGL_VERSION=2 -s MIN_WEBGL_VERSION=2</EmccExtraLDFlags>
  </PropertyGroup>
</Project>
