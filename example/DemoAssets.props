<Project>

  <!--
    演示资产刻意不走 <AvaloniaResource>：那等于把整个 assets 目录编进程序集，浏览器端就变成一个
    168MB 的 Example.wasm，启动前必须整包下载。这里改为四个宿主各自把 example/assets 原样拷出去，
    由共享工程按平台取用：桌面/iOS/Android 用 FileAssetProvider 探测 <BaseDirectory>/assets，
    浏览器用 WebAssetProvider 取相对 URL assets/，逐页懒下载。
  -->

  <ItemGroup Condition="!$(TargetFramework.Contains('-browser'))">
    <Content Include="$(MSBuildThisFileDirectory)assets\**\*"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    浏览器宿主必须走另一条路：站点根只有 wwwroot，落在它旁边的 assets 目录压根不可寻址
    （表现为所有需要下载资源的页面一律 404）。要真正被带上，两件事缺一不可：
      1. 文件出现在 Example.Browser/wwwroot/assets 下；
      2. 这些文件以 Content 项的身份被静态资产管线登记——dotnet run 的开发期清单与
         dotnet publish 都只认这份清单，不扫盘。
    只做第 1 步（单纯复制）会在同一次构建里失效：SDK 的 <Content Include="wwwroot\**"> 在项目求值
    阶段就展开了，复制发生在它之后，于是新克隆/CI 的第一次构建产物里没有资产，第二次才有——
    这种「换台机器就 404」的差别正是最难查的那类。所以复制与登记放在同一个目标里，并排在
    SDK 发现本项目静态资产（ResolveProjectStaticWebAssets，注入在 AssignTargetPaths 之前）之前；
    登记用的通配符写在目标体内，执行阶段重新展开就能拿到刚复制出来的文件。
    wwwroot/assets 是构建产物，已进 .gitignore。
  -->
  <ItemGroup Condition="$(TargetFramework.Contains('-browser'))">
    <_DemoAssetSource Include="$(MSBuildThisFileDirectory)assets\**\*.*" />
  </ItemGroup>

  <Target Name="SyncDemoAssetsIntoWwwroot"
          Condition="$(TargetFramework.Contains('-browser'))"
          Inputs="@(_DemoAssetSource)"
          Outputs="@(_DemoAssetSource->'$(MSBuildProjectDirectory)\wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(_DemoAssetSource)"
          DestinationFiles="@(_DemoAssetSource->'$(MSBuildProjectDirectory)\wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="演示资产已同步进 wwwroot/assets（@(_DemoAssetSource->Count()) 个文件）" />
  </Target>

  <Target Name="RegisterDemoAssetsAsStaticWebFiles"
          Condition="$(TargetFramework.Contains('-browser'))"
          DependsOnTargets="SyncDemoAssetsIntoWwwroot"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Include="wwwroot\assets\**\*.*"
               ExcludeFromSingleFile="true"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
