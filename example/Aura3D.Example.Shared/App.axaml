<Application x:Class="Aura3D.Examples.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="clr-namespace:Semi.Avalonia;assembly=Semi.Avalonia"
             xmlns:u-semi="clr-namespace:Ursa.Themes.Semi;assembly=Ursa.Themes.Semi"
             xmlns:cp="clr-namespace:Semi.Avalonia.ColorPicker;assembly=Semi.Avalonia.ColorPicker">

  <!--
    示例应用的主题装配：Semi 打底，Ursa 与取色器跟随同一套 Semi 主题，
    最后并入检视面板行控件的外观（Themes/Inspector.axaml）。
    四个平台（桌面、浏览器、Android、iOS）共用这一个 App，平台差异只在资产来源一处。
  -->
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <u-semi:UrsaSemiTheme Locale="zh-CN" />
    <cp:ColorPickerSemiTheme />
    <StyleInclude Source="avares://Aura3D.Example.Shared/Themes/Inspector.axaml" />
  </Application.Styles>

</Application>
