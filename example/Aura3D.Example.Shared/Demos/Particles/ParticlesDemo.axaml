<ex:Demo x:Class="Aura3D.Examples.Demos.ParticlesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Examples"
         xmlns:loc="clr-namespace:Aura3D.Examples.Localization"
         xmlns:demos="clr-namespace:Aura3D.Examples.Demos"
         xmlns:kit="clr-namespace:Aura3D.Examples.Kit"
         x:DataType="demos:ParticlesDemo">

  <!--
    粒子页：公告板、一次性爆发、网格模式三条发射路径各占一段。
    参数行的排版全在 .axaml 里，滑杆初值取自发射器对象，因此由构造函数写回行控件。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Particles_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Fountain}}" />

        <kit:SliderRow x:Name="FountainRateRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_FountainRate}}" Minimum="0" Maximum="6000" Format="0"
                       ValueChanged="OnFountainRateChanged" />
        <kit:SliderRow x:Name="FountainConeAngleRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_ConeAngle}}" Minimum="0" Maximum="80" Format="0"
                       ValueChanged="OnFountainConeAngleChanged" />
        <kit:SliderRow x:Name="FountainGravityRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_GravityY}}" Minimum="-30" Maximum="5" Format="0.0"
                       ValueChanged="OnFountainGravityChanged" />
        <kit:SliderRow x:Name="FountainDampingRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_Damping}}" Minimum="0" Maximum="6"
                       ValueChanged="OnFountainDampingChanged" />
        <kit:SliderRow x:Name="FountainStartSizeRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_StartSize}}" Minimum="0.05" Maximum="3"
                       ValueChanged="OnFountainStartSizeChanged" />

        <kit:ComboRow x:Name="TextureRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_Map}}" Options="{Binding TextureOptions}"
                      SelectionChanged="OnTextureChanged" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Particles_FlipbookTiles}}" Minimum="1" Maximum="8" Value="8" Format="0"
                       ValueChanged="OnFlipbookTilesChanged" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Particles_FlipbookNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Burst}}" />

        <kit:SliderRow x:Name="BurstRateRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_BurstRate}}" Minimum="0" Maximum="60000" Format="0"
                       ValueChanged="OnBurstRateChanged" />
        <kit:SliderRow x:Name="BurstDurationRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_Duration}}" Minimum="0" Maximum="4"
                       ValueChanged="OnBurstDurationChanged" />
        <kit:SliderRow x:Name="BurstLifetimeRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_MaxLife}}" Minimum="0.2" Maximum="8"
                       ValueChanged="OnBurstLifetimeChanged" />
        <kit:SliderRow x:Name="BurstVelocityRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_MaxSpeed}}" Minimum="0" Maximum="20" Format="0.0"
                       ValueChanged="OnBurstVelocityChanged" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Particles_Replay}}" Click="OnBurstRestart" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Debris}}" />

        <kit:SliderRow x:Name="DebrisRateRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_DebrisRate}}" Minimum="0" Maximum="400" Format="0"
                       ValueChanged="OnDebrisRateChanged" />
        <kit:SliderRow x:Name="DebrisSpinRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_SpinSpeed}}" Minimum="0" Maximum="12" Format="0.0"
                       ValueChanged="OnDebrisSpinChanged" />
        <kit:SliderRow x:Name="DebrisMeshScaleRow" Label="MeshScale" Minimum="0.1" Maximum="4"
                       ValueChanged="OnDebrisMeshScaleChanged" />
        <kit:SliderRow x:Name="DebrisMaxParticlesRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_MaxParticles}}" Minimum="50" Maximum="20000" Format="0"
                       ValueChanged="OnDebrisMaxParticlesChanged" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Particles_ApplyMaxParticles}}" Click="OnDebrisRestart" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Particles_Shared}}" />

        <kit:ComboRow x:Name="BlendModeRow" Label="{Translate {x:Static loc:Strings+Keys.Particles_BlendMode}}" Options="{Binding BlendModeOptions}"
                      SelectionChanged="OnBlendModeChanged" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Particles_RestartAll}}" Click="OnRestartAll" HorizontalAlignment="Stretch" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Particles_PauseAll}}" IsChecked="False" Toggled="OnPauseToggled" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Particles_VisibilityCulling}}" IsChecked="False" Toggled="OnCullingToggled" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Particles_ShowBounds}}" IsChecked="True" Toggled="OnShowBoundsToggled" />

        <kit:ReadoutRow x:Name="Readout" Label="{Translate {x:Static loc:Strings+Keys.Particles_State}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
