<ex:Demo x:Class="Aura3D.Examples.Demos.PipelinesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Examples"
         xmlns:loc="clr-namespace:Aura3D.Examples.Localization"
         xmlns:demos="clr-namespace:Aura3D.Examples.Demos"
         xmlns:kit="clr-namespace:Aura3D.Examples.Kit"
         x:DataType="demos:PipelinesDemo">

  <!--
    五条管线对照页。整页就是这两层：视口 + 浮在右侧的检视面板。
    这里声明的只是注册表里的默认管线；换管线用宿主状态栏的管线框（全示例统一走那一个入口）。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Pipelines_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Pipelines_Lights}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Pipelines_LightPitch}}" Minimum="-89" Maximum="0" Value="-46" Format="0"
                       ValueChanged="OnSunAngleChanged" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Pipelines_LightShadow}}" IsChecked="True" Toggled="OnSunCastToggled" />
        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Pipelines_PointLightVisible}}" IsChecked="True" Toggled="OnPointEnableToggled" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Pipelines_Readout}}" />

        <kit:ReadoutRow x:Name="ChannelsReadout" Label="{Translate {x:Static loc:Strings+Keys.Pipelines_Channels}}" />
        <kit:ReadoutRow x:Name="PassesReadout" Label="{Translate {x:Static loc:Strings+Keys.Pipelines_Passes}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
