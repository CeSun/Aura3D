<Window x:Class="Aura3D.Examples.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Aura3D.Examples.Localization"
        Width="1280"
        Height="800"
        MinWidth="520"
        MinHeight="360"
        Title="{Translate {x:Static loc:Strings+Keys.Shell_WindowTitle}}"
        Background="White">

  <!--
    桌面窗口只是一个壳：真正的目录 + 功能页宿主在 MainShell 里，
    浏览器/Android/iOS 用同一套 MainShell 塞进单视图，因此这里不写任何业务。
  -->
  <ContentControl x:Name="ShellSlot" />

</Window>
