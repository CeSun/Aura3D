<UserControl x:Class="Aura3D.Examples.MainShell"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ex="clr-namespace:Aura3D.Examples"
             xmlns:loc="clr-namespace:Aura3D.Examples.Localization"
             x:DataType="ex:MainShell">

  <!--
    示例应用的主外壳：左侧功能目录、中间功能页宿主。
    目录由 DemoRegistry 生成的分组视图驱动，新增功能页不需要动这里。
  -->
  <UserControl.Styles>
    <Style Selector="Button.navItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="#F2F4F8"
            BorderBrush="#DDDDE4"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,6">
        <ToggleButton Content="{Translate {x:Static loc:Strings+Keys.Nav_Catalog}}"
                      IsChecked="{Binding NavPinned, Mode=TwoWay}"
                      Padding="10,4"
                      VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding PageTitle}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="10,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2"
                   Text="{Binding PageSummary}"
                   FontSize="11"
                   Foreground="Gray"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="3"
                Content="{Translate {x:Static loc:Strings+Keys.Lang_Switch}}"
                Click="OnLanguageClicked"
                Margin="10,0,0,0"
                Padding="8,3"
                FontSize="11"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Left"
            Width="244"
            Background="#FAFAFC"
            BorderBrush="#DDDDE4"
            BorderThickness="0,0,1,0"
            IsVisible="{Binding NavPinned}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBox PlaceholderText="{Translate {x:Static loc:Strings+Keys.Nav_Search}}"
                   Text="{Binding Keyword, Mode=TwoWay}"
                   Margin="8,6" />
          <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ex:NavGroup">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Title}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="Gray"
                             Margin="10,10,8,2" />
                  <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ex:NavEntry">
                        <Button Classes="navItem"
                                Click="OnNavClicked"
                                Tag="{Binding Id}">
                          <Panel>
                            <Border Background="#DCE6F5"
                                    CornerRadius="4"
                                    IsVisible="{Binding IsSelected}" />
                            <Border Width="2"
                                    Background="#4A6DE5"
                                    HorizontalAlignment="Left"
                                    CornerRadius="1"
                                    IsVisible="{Binding IsSelected}" />
                            <Grid ColumnDefinitions="*,Auto" Margin="10,5">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding SizeLabel}"
                                         FontSize="10"
                                         Foreground="Gray"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </Panel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ex:DemoHost x:Name="Host" />

  </DockPanel>
</UserControl>
