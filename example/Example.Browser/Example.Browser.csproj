<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmLinkIcalls>false</WasmLinkIcalls>
  </PropertyGroup>

  <!--
    No native linking or emscripten configuration is hand written here: WasmBuildNative, required by the browser backend, and the
    -s FULL_ES3 / WEBGL_VERSION switches are injected by the buildTransitive props of Aura3D.Avalonia.Browser
    (pulled in through the browser target dependency of Aura3D.Avalonia). Example consumes it in exactly the same way as external users.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Example\Example.csproj" />
  </ItemGroup>
</Project>
