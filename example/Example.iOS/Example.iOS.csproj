<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
   <OutputType>Exe</OutputType>
   <TargetFramework>net10.0-ios27.0</TargetFramework>
   <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
   <Nullable>enable</Nullable>
   <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
   <!-- iOS 27 SDK 预览版：抑制 Xcode 版本预览告警 -->
   <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>

  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <!--
    ANGLE 的 iOS framework 有两种来源，二选一：
      默认：本地 ANGLE 构建目录（AngleIosOutDir），CI 上没有可还原的包，走这条；
      -p:Aura3DAngleFromPackage=true：改由 Aura3D.Angle.iOS 包注入，先执行
        dotnet pack src/Aura3D.Angle.iOS -o artifacts/nupkgs
    两者都没有时仍然构建成功，只是运行时视口不出图（宿主符号解析不到 ANGLE）。
  -->
  <PropertyGroup>
    <AngleIosOutDir Condition=" '$(AngleIosOutDir)' == '' ">$([System.Environment]::GetEnvironmentVariable('HOME'))/angle_ios/out/ios</AngleIosOutDir>
    <RestoreAdditionalProjectSources Condition=" Exists('$(MSBuildThisFileDirectory)../../artifacts/nupkgs') ">$(MSBuildThisFileDirectory)../../artifacts/nupkgs</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition=" '$(Aura3DAngleFromPackage)' == 'true' ">
    <PackageReference Include="Aura3D.Angle.iOS" />
  </ItemGroup>
  <ItemGroup Condition=" '$(Aura3DAngleFromPackage)' != 'true' And Exists('$(AngleIosOutDir)/libEGL.framework') ">
    <NativeReference Include="$(AngleIosOutDir)/libEGL.framework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="$(AngleIosOutDir)/libGLESv2.framework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Example\Example.csproj" />
  </ItemGroup>
</Project>
