<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
   <OutputType>Exe</OutputType>
   <TargetFramework>net10.0-ios27.0</TargetFramework>
   <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
   <Nullable>enable</Nullable>
   <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
   <!-- iOS 27 SDK 预览版：抑制 Xcode 版本预览告警 -->
   <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>

  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <!--
    这里不写任何 ANGLE 相关的配置：Aura3D.Angle.iOS 由 Aura3D.Avalonia 的精确区间依赖带进来，
    包内 buildTransitive targets 按 $(RuntimeIdentifier) 在 simulator / device 切片间选择并注入
    NativeReference。Example 与外部用户走的是完全同一条消费路径。
  -->
  <ItemGroup>
    <ProjectReference Include="..\Example\Example.csproj" />
  </ItemGroup>
</Project>
