<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
   <OutputType>Exe</OutputType>
   <TargetFramework>net10.0-ios27.0</TargetFramework>
   <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
   <Nullable>enable</Nullable>
   <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
   <!-- iOS 27 SDK 预览版：抑制 Xcode 版本预览告警 -->
   <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>

  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <!--
    ANGLE 的 iOS framework 由 Aura3D.Angle.iOS 的 targets 注入：仓库内直接 Import 包里的
    同一份文件（切片已入库），外部用户则通过 PackageReference 从 nuget.org 拿到它。
    按 $(RuntimeIdentifier) 在 simulator / device 切片间自动选择。
  -->
  <Import Project="$(MSBuildThisFileDirectory)../../src/Aura3D.Angle.iOS/build/Aura3D.Angle.iOS.targets" />

  <ItemGroup>
    <ProjectReference Include="..\Example\Example.csproj" />
  </ItemGroup>
</Project>
