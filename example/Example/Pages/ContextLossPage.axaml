<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Example.ViewModels"
             xmlns:pages="clr-namespace:Example.Pages"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:DataType="vm:ContextLossViewModel"
             x:Class="Example.Pages.ContextLossPage">

  <Design.DataContext>
    <vm:ContextLossViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- ═══════════════════════════════════════════════ Right Control Panel ═══ -->
    <ScrollViewer DockPanel.Dock="Right" Width="340">
      <StackPanel Spacing="8" Margin="8">

        <Border Theme="{StaticResource CardBorder}" Padding="10">
          <StackPanel Spacing="6">
            <TextBlock FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource SemiGrey10}" Text="🎛 GPU Context State" />
            <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="Bold"
                       Foreground="{Binding StatusColor}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ViewStateText}" FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />
            <Separator Height="1" Background="#444" Margin="0,2" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" >
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Context Lost" FontSize="12" Width="80" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LossCount}" FontSize="12" FontWeight="Bold" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Context Restored" FontSize="12" Width="80" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RestoreCount}" FontSize="12" FontWeight="Bold" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding SceneBuildCount, StringFormat='Scene Rebuilds {0}'}" FontSize="11" Foreground="#AAA" />
              <TextBlock Text="{Binding FrameCount, StringFormat='Total Frames {0}'}" FontSize="11" Foreground="#AAA" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource CardBorder}" Padding="10">
          <StackPanel Spacing="6">
            <TextBlock FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource SemiGrey10}" Text="🕹 Actions" />
            <Button x:Name="SimulateButton" Click="SimulateContextLost_Click"
                    IsEnabled="False" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" FontWeight="Bold"
                    Content="⚠ Simulate GL Context Loss" />
            <Button x:Name="AttachButton" Click="ToggleAttach_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Detach View (Release GPU Resources)" />
            <Button Click="ReleaseGpuResources_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Release GPU Resources (Keep Scene)" />
            <Button Click="DestroyScene_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Destroy Scene" />
            <Button Click="AddNode_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Add Cube" />
            <CheckBox x:Name="AutoCycleCheckBox" Click="AutoCycle_Click"
                      Content="Auto context loss every 2 seconds" />
            <Button Click="ClearLog_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Clear Log" />
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource CardBorder}" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource SemiGrey10}" Text="📖 Notes" />
            <TextBlock FontSize="11" Foreground="#AAA" TextWrapping="Wrap"
                       Text="A simulated loss reuses the same GL context: handles are marked invalid but not deleted (a real loss is reclaimed by the driver). Detaching the view runs OnOpenGlDeinit → ReleaseGpuResources(), which really deletes the GL objects before the context is destroyed to free video memory, while the scene and its nodes are retained; re-attaching reuses the same scene and only rebuilds GPU resources, without raising SceneInitialized again. Destroying the scene releases GPU resources and clears Scene, and an empty scene is rebuilt automatically on the next frame." />
          </StackPanel>
        </Border>

        <Border Theme="{StaticResource CardBorder}" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource SemiGrey10}" Text="📋 Event Log" />
            <ListBox ItemsSource="{Binding Log}" Height="300" BorderThickness="0"
                     Background="#1E1E2E" FontSize="11"
                     FontFamily="Consolas,Menlo,Monospace"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ═══════════════════════════════════════════════ 3D Viewport ═══ -->
    <ContentControl x:Name="ViewHost">
      <pages:ContextLossTestView x:Name="aura3DView"
                                 SceneInitialized="Aura3DView_SceneInitialized"
                                 SceneDestroyed="Aura3DView_SceneDestroyed"
                                 SceneUpdated="Aura3DView_SceneUpdated"
                                 ContextLost="Aura3DView_ContextLost"
                                 ContextRestored="Aura3DView_ContextRestored" />
    </ContentControl>
  </DockPanel>
</UserControl>
