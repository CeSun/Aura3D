<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.0.3</AvaloniaVersion>
    <!-- 只有一件事：下面两条精确区间钉住消费方拿到的切片包版本。
         两个切片工程自己的 <Version> 不再引用这两个属性，改成在各自 csproj 里写死，
         所以「包里是哪个版本」和「主包钉哪个版本」现在是两处字面值，必须成对改：
         发版走 build-ios-lib.yml / build-browser-lib.yml，触发时输入版本号（-p:Version 覆盖工程里那行）；
         发完把这里改成同一个号，工程里那行也补成同一个号。
         漏改这里 = 主包继续钉旧切片；漏改工程里那行 = 两处字面值对不上，
         build-ios-lib.yml / build-browser-lib.yml 的核对步直接 ::error:: 退出，不会让仓库里的切片
         与消费方实际拿到的切片分叉。本仓库自身的 restore 也按这里的精确区间从 nuget.org 取切片包，
         所以这里必须先是线上已经发布的号。切片工程不走 MinVer（版本不来自 git tag）。 -->
    <Aura3DAngleIosVersion>0.1.0</Aura3DAngleIosVersion>
    <Aura3DAngleMacosVersion>0.1.0</Aura3DAngleMacosVersion>
    <Aura3DAvaloniaBrowserVersion>0.1.0</Aura3DAvaloniaBrowserVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="AssimpNetter" Version="6.0.2.1" />
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    <!-- 精确区间：ANGLE 的 native 切片与 Aura3D.Avalonia 里的 DllImport 签名是 ABI 配对，
         不能让消费方被动升到一个没配套测过的切片上。 -->
    <!-- 与 iOS 同为精确区间：Aura3D.Avalonia 的 MacAngle 会话按包内 dylib 的导出符号 ABI 配对，
         不能让消费方被动升到一个没配套测过的切片上。 -->
    <PackageVersion Include="Aura3D.Angle.iOS" Version="[$(Aura3DAngleIosVersion)]" />
    <PackageVersion Include="Aura3D.Angle.MacOS" Version="[$(Aura3DAngleMacosVersion)]" />
    <!-- 同样是精确区间：包里的 wasm 链接开关与浏览器后端的 GLES 调用面配对，升降级要和库一起过验证。 -->
    <PackageVersion Include="Aura3D.Avalonia.Browser" Version="[$(Aura3DAvaloniaBrowserVersion)]" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Irihi.Lingua" Version="1.0.0" />
    <PackageVersion Include="Irihi.Ursa" Version="2.0.0-rc1" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.0.0-rc1" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Semi.Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Silk.NET" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Assimp" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Core" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Input.Common" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <PackageVersion Include="SharpGLTF.Toolkit" Version="1.0.5" />
    <PackageVersion Include="Silk.NET.OpenGLES" Version="2.22.0" />
    <PackageVersion Include="StbImageSharp" Version="2.30.15" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>