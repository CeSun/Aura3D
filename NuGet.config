<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Aura3D.Avalonia 的 iOS 目标以精确区间 [0.1.0] 依赖 Aura3D.Angle.iOS，而这个包还没发到
      nuget.org 时仓库自身也要能构建：切片包由本仓库自己 pack 到 local-feed/。
      首次克隆后必须先执行一次：
          dotnet pack src/Aura3D.Angle.iOS -c Release -o local-feed
      CI 的各个作业在同一次运行里做同样的事，所以外部用户装的仍是 nuget.org 上的同一个包。
    -->
    <add key="aura3d-local-feed" value="local-feed" />
  </packageSources>
</configuration>
