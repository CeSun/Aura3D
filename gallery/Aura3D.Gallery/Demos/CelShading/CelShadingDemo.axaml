<ex:Demo x:Class="Aura3D.Gallery.Demos.CelShadingDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:CelShadingDemo">

  <!--
    卡通着色页。视口 + 右侧浮在上面的检视面板，参数行全在这里声明。
    通道开关与 ramp 行的 Tag 是材质参数名，代码里按 Tag 回到 plugged / numbers 字典。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="CelShading" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_Channels}}" />

        <kit:ToggleRow Tag="BaseColor" Label="{Translate {x:Static loc:Strings+Keys.CelShading_BaseColor}}" IsChecked="True" Toggled="OnChannelToggled" />
        <kit:ToggleRow Tag="Normal" Label="{Translate {x:Static loc:Strings+Keys.CelShading_Normal}}" IsChecked="False" Toggled="OnChannelToggled" />
        <kit:ToggleRow Tag="ILM" Label="{Translate {x:Static loc:Strings+Keys.CelShading_Ilm}}" IsChecked="True" Toggled="OnChannelToggled" />
        <kit:ToggleRow Tag="ShadowRamp" Label="{Translate {x:Static loc:Strings+Keys.CelShading_ShadowRamp}}" IsChecked="True" Toggled="OnChannelToggled" />
        <kit:ToggleRow Tag="SDF" Label="{Translate {x:Static loc:Strings+Keys.CelShading_Sdf}}" IsChecked="True" Toggled="OnChannelToggled" />
        <kit:ToggleRow Tag="SpecularRamp" Label="{Translate {x:Static loc:Strings+Keys.CelShading_SpecularRamp}}" IsChecked="False" Toggled="OnChannelToggled" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_HalfLambert}}" />

        <kit:SliderRow Tag="_GreyFac" Label="{Translate {x:Static loc:Strings+Keys.CelShading_GreyFac}}" Minimum="0.05" Maximum="2" Value="0.8"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_DarkFac" Label="{Translate {x:Static loc:Strings+Keys.CelShading_DarkFac}}" Minimum="-1" Maximum="1" Value="0.15"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_BrightFac" Label="{Translate {x:Static loc:Strings+Keys.CelShading_BrightFac}}" Minimum="0" Maximum="1" Value="0.72"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_BrightAreaShadowFac" Label="{Translate {x:Static loc:Strings+Keys.CelShading_BrightAreaShadowFac}}" Minimum="0" Maximum="1" Value="0.85"
                       ValueChanged="OnNumberChanged" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_RampRows}}" />

        <kit:SliderRow Tag="_RampIndex0" Label="_RampIndex0 · _RampIndex0" Minimum="0" Maximum="5" Value="0"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_RampIndex1" Label="_RampIndex1 · _RampIndex1" Minimum="0" Maximum="5" Value="1"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_RampIndex2" Label="_RampIndex2 · _RampIndex2" Minimum="0" Maximum="5" Value="2"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_RampIndex3" Label="_RampIndex3 · _RampIndex3" Minimum="0" Maximum="5" Value="3"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_RampIndex4" Label="_RampIndex4 · _RampIndex4" Minimum="0" Maximum="5" Value="4"
                       ValueChanged="OnNumberChanged" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_RampRowsNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_TintSlots}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_LightAreaTint}}" Minimum="0" Maximum="2" Value="1.15"
                       ValueChanged="OnLightTintChanged" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_DarkShadow}}" Minimum="0" Maximum="2" Value="0.55"
                       ValueChanged="OnDarkTintChanged" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_CoolShadow}}" Minimum="0" Maximum="2" Value="0.45"
                       ValueChanged="OnCoolDarkChanged" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_CoolShadowNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_FaceOnly}}" />

        <kit:SliderRow Tag="_FaceShadowOffset" Label="{Translate {x:Static loc:Strings+Keys.CelShading_FaceShadowOffset}}" Minimum="-1" Maximum="1" Value="0.1"
                       ValueChanged="OnNumberChanged" />
        <kit:SliderRow Tag="_FaceShadowTransitionSoftness" Label="{Translate {x:Static loc:Strings+Keys.CelShading_FaceShadowSoftness}}" Minimum="0.01" Maximum="1" Value="0.15"
                       ValueChanged="OnNumberChanged" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.CelShading_FaceRenderType}}" IsChecked="True"
                       Toggled="OnFaceRenderToggled" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.CelShading_OutlinePass}}" />

        <kit:SliderRow Label="OutlinePass.AmbientIntensity" Minimum="0" Maximum="1" Value="0.1"
                       ValueChanged="OnOutlineAmbientChanged" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.CelShading_OutlineNote}}" />

        <kit:SliderRow x:Name="SettingsAmbientRow" Label="Settings.AmbientIntensity" Minimum="0" Maximum="2"
                       ValueChanged="OnSettingsAmbientChanged" />

        <kit:ReadoutRow x:Name="Readout" Label="{Translate {x:Static loc:Strings+Keys.CelShading_Bindings}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
