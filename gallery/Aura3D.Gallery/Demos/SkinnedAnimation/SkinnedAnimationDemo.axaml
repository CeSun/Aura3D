<ex:Demo x:Class="Aura3D.Gallery.Demos.SkinnedAnimationDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:SkinnedAnimationDemo">

  <!--
    蒙皮动画与骨骼挂载页。整页两层：视口 + 浮在右侧的检视面板。
    参数行的排版全在这里，剪辑下拉的选项要到场景组装时才填（动画来自 glb 文件）。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_Playback}}" />

        <kit:ComboRow x:Name="ClipCombo" Label="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_Clip}}" SelectionChanged="OnClipChanged" />

        <kit:SliderRow Label="TimeScale" Minimum="0" Maximum="3" Value="1" Format="0.00"
                       ValueChanged="OnTimeScaleChanged" />

        <kit:ComboRow x:Name="LoopModeCombo" Label="LoopMode" Options="{Binding LoopModeOptions}"
                      SelectionChanged="OnLoopModeChanged" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_Reset}}" Click="OnReset" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_Driver}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_ExternalUpdate}}" IsChecked="False"
                       Toggled="OnExternalUpdateToggled" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_DriveNote}}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_AdvanceStep}}" Click="OnManualStep" HorizontalAlignment="Stretch" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_Bones}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_ShowBone}}" IsChecked="True"
                       Toggled="OnShowBoneToggled" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_Attachment}}" IsChecked="True"
                       Toggled="OnAttachmentToggled" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_AttachmentYaw}}" Minimum="-180" Maximum="180" Value="0" Format="0"
                       ValueChanged="OnAttachmentYawChanged" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_AttachNote}}" />

        <kit:ReadoutRow x:Name="BoneReadout" Label="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_BonePicker}}" />

        <kit:ReadoutRow x:Name="Readout" Label="{Translate {x:Static loc:Strings+Keys.SkinnedAnimation_PlaybackState}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
