<ex:Demo x:Class="Aura3D.Gallery.Demos.PrimitivesDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:PrimitivesDemo">

  <!--
    图元页。整页就是这两层：视口 + 浮在右侧的检视面板。
    本页锁死 NoLight：顶点色与点精灵的着色器只覆盖了 NoLightPass。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="NoLight" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Primitives_Intro}}" />

        <kit:ComboRow x:Name="FocusRow" Label="{Translate {x:Static loc:Strings+Keys.Primitives_Focus}}" Options="{Binding KindOptions}"
                      SelectionChanged="OnFocusChanged" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Primitives_VertexData}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Primitives_Columns}}" Minimum="2" Maximum="40" Value="12" Format="0"
                       ValueChanged="OnColumnsChanged" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Primitives_Rows}}" Minimum="1" Maximum="24" Value="6" Format="0"
                       ValueChanged="OnRowsChanged" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Primitives_Amplitude}}" Minimum="0" Maximum="3" Value="0.9"
                       ValueChanged="OnWaveChanged" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Primitives_PointPrimitives}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Primitives_PointSize}}" Minimum="1" Maximum="64" Value="12" Format="0"
                       ValueChanged="OnPointSizeChanged" />

        <kit:ReadoutRow x:Name="CurrentReadout" Label="{Translate {x:Static loc:Strings+Keys.Primitives_Current}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
