<ex:Demo x:Class="Aura3D.Gallery.Demos.CameraDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:CameraDemo">

  <!--
    相机页：视口 + 一层跟随 WorldToScreen 的十字标记 + 右侧检视浮层。
    十字标记只用来对照屏幕坐标口径，所以整层不参与命中测试。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <Canvas x:Name="Overlay" IsHitTestVisible="False">
      <Path x:Name="Crosshair"
            Data="M 0,-8 L 0,8 M -8,0 L 8,0"
            Stroke="Yellow"
            StrokeThickness="2" />
    </Canvas>

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Camera_Intro}}" />

        <kit:ComboRow x:Name="ProjectionRow" Label="{Translate {x:Static loc:Strings+Keys.Camera_Projection}}"
                      Options="{Binding ProjectionOptions}"
                      SelectionChanged="OnProjectionChanged" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Camera_Frustum}}" />

        <kit:SliderRow Label="FieldOfView °" Minimum="15" Maximum="120" Value="60" Format="0" ShowTicks="True"
                       ValueChanged="OnFieldOfViewChanged" />
        <kit:SliderRow Label="OrthographicSize" Minimum="0.5" Maximum="20" Value="4" ShowTicks="True"
                       ValueChanged="OnOrthographicSizeChanged" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Camera_NearPlane}}" Minimum="0.01" Maximum="12" Value="0.1" ShowTicks="True"
                       ValueChanged="OnNearChanged" />
        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.Camera_FarPlane}}" Minimum="2" Maximum="120" Value="100" Format="0.#" ShowTicks="True"
                       ValueChanged="OnFarChanged" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Camera_Framing}}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Camera_FitFifthBox}}" Click="OnFitClicked" HorizontalAlignment="Stretch" />
        <Button Content="{Translate {x:Static loc:Strings+Keys.Camera_ResetCamera}}" Click="OnResetClicked" HorizontalAlignment="Stretch" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Camera_RenderBackground}}" IsChecked="True" Toggled="OnRenderBackgroundToggled" />

        <kit:ReadoutRow x:Name="ScreenReadout" Label="{Translate {x:Static loc:Strings+Keys.Camera_Box0Projection}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
