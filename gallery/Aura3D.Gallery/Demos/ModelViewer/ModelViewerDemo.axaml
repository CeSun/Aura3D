<ex:Demo x:Class="Aura3D.Gallery.Demos.ModelViewerDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:ModelViewerDemo">

  <!--
    glTF 模型页。视口 + 右侧检视面板，参数行全在这里声明。
    两个下拉的 Options 绑到本页暴露的 IList 属性，选中项在建页时按当前状态设初值。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="BlinnPhong" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.ModelViewer_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.ModelViewer_Model}}" />

        <kit:ComboRow x:Name="ModelRow" Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_CurrentModel}}" Options="{Binding ModelLabels}"
                      SelectionChanged="OnModelChanged" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.ModelViewer_Fit}}" Click="OnFit" HorizontalAlignment="Stretch" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_FitPadding}}" Minimum="0" Maximum="1" Value="0.12"
                       ValueChanged="OnPaddingChanged" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.ModelViewer_BoundingBox}}" />

        <kit:SliderRow Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_BoxPadding}}" Minimum="0" Maximum="1.5" Value="0"
                       ValueChanged="OnBoxPaddingChanged" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_CustomBox}}" IsChecked="False"
                       Toggled="OnCustomBoxToggled" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_ShowBox}}" IsChecked="True"
                       Toggled="OnShowBoxToggled" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.ModelViewer_BoxNote}}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.ModelViewer_Reframe}}" Click="OnFit" HorizontalAlignment="Stretch" />

        <kit:ReadoutRow x:Name="BoxReadout" Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_BoundingBoxRow}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.ModelViewer_CloneModes}}" />

        <kit:ComboRow x:Name="CopyModeRow" Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_CloneType}}" Options="{Binding CopyModeOptions}"
                      SelectionChanged="OnCopyModeChanged" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.ModelViewer_CloneNote}}" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.ModelViewer_ClearClones}}" Click="OnClearClones" HorizontalAlignment="Stretch" />

        <kit:ReadoutRow x:Name="CloneReadout" Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_Sharing}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.ModelViewer_LoadOnDemand}}" />

        <kit:ReadoutRow x:Name="LoadReadout" Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_LoadLog}}" Text="{Translate {x:Static loc:Strings+Keys.ModelViewer_LoadHint}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.ModelViewer_LoaderOutput}}" />

        <kit:ReadoutRow x:Name="StructureReadout" Label="{Translate {x:Static loc:Strings+Keys.ModelViewer_Structure}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
