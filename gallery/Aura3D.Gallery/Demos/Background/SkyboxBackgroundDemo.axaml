<ex:Demo x:Class="Aura3D.Gallery.Demos.SkyboxBackgroundDemo"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ex="clr-namespace:Aura3D.Gallery"
         xmlns:loc="clr-namespace:Aura3D.Gallery.Localization"
         xmlns:demos="clr-namespace:Aura3D.Gallery.Demos"
         xmlns:kit="clr-namespace:Aura3D.Gallery.Kit"
         x:DataType="demos:SkyboxBackgroundDemo">

  <!--
    背景来源与天空盒页。整页两层：视口 + 浮在右侧的检视面板。
    参数行的排版全在这里，代码只剩场景组装与回调。
  -->
  <Panel>

    <kit:DemoView x:Name="View" Pipeline="PBRForward" />

    <kit:InspectorPanel>
      <StackPanel Spacing="6">

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_Intro}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Background_Source}}" />

        <kit:ComboRow x:Name="SourceCombo" Label="Scene.Background" Options="{Binding SourceOptions}"
                      SelectionChanged="OnSourceChanged" />

        <kit:SliderRow x:Name="CubeFaceRow" Label="{Translate {x:Static loc:Strings+Keys.Background_CubeSize}}" Minimum="32" Maximum="256" Format="0"
                       ValueChanged="OnCubeFaceChanged" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Background_RenderBackground}}" IsChecked="True"
                       Toggled="OnRenderBackgroundToggled" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_ClearNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Background_ShaderVariants}}" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Background_Orthographic}}" IsChecked="False"
                       Toggled="OnOrthographicToggled" />

        <kit:SliderRow x:Name="OrthoSizeRow" Label="{Translate {x:Static loc:Strings+Keys.Background_OrthoSize}}" Minimum="2" Maximum="40" Format="0"
                       ValueChanged="OnOrthoSizeChanged" />

        <kit:SliderRow x:Name="FovRow" Label="{Translate {x:Static loc:Strings+Keys.Background_FieldOfView}}" Minimum="15" Maximum="120" Format="0"
                       ValueChanged="OnFovChanged" />

        <kit:SliderRow x:Name="FarPlaneRow" Label="{Translate {x:Static loc:Strings+Keys.Background_FarPlane}}" Minimum="5" Maximum="400" Format="0"
                       ValueChanged="OnFarPlaneChanged" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_ProjectionNote}}" />

        <kit:Section Title="{Translate {x:Static loc:Strings+Keys.Background_CubemapFeedsIbl}}" />

        <kit:SliderRow x:Name="AmbientRow" Label="IblAmbientIntensity" Minimum="0" Maximum="4"
                       ValueChanged="OnIblAmbientChanged" />

        <kit:SliderRow x:Name="ExposureRow" Label="ToneMappingExposure" Minimum="0.05" Maximum="4"
                       ValueChanged="OnExposureChanged" />

        <kit:ToggleRow Label="{Translate {x:Static loc:Strings+Keys.Background_KeyLightVisible}}" IsChecked="True"
                       Toggled="OnSunVisibleToggled" />

        <Button Content="{Translate {x:Static loc:Strings+Keys.Background_RebakeIbl}}" Click="OnRebake" HorizontalAlignment="Stretch" />

        <kit:Hint Text="{Translate {x:Static loc:Strings+Keys.Background_IblNote}}" />

        <kit:ReadoutRow x:Name="Readout" Label="{Translate {x:Static loc:Strings+Keys.Background_IblCache}}" />

      </StackPanel>
    </kit:InspectorPanel>

  </Panel>
</ex:Demo>
